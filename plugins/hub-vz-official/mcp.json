{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hub-vz-official": {
      "type": "streamable-http",
      "url": "https://hub.vezetiv.dev/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["mcp:read", "offline_access", "mcp:write"]
          }
        }
      }
    }
  }
}
