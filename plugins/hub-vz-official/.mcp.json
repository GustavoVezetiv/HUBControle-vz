{
  "mcpServers": {
    "hub-vz-official": {
      "type": "streamable-http",
      "url": "https://hub.vezetiv.dev/api/mcp",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["mcp:read", "offline_access", "mcp:write"]
          }
        }
      }
    }
  }
}
