NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only Google Tasks OAuth. Do not expose these in client code.
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=
GOOGLE_TASKS_TOKEN_ENCRYPTION_KEY=

# Server-only Gemini API. Do not expose this in client code.
GEMINI_API_KEY=
GEMINI_WEEKLY_REVIEW_MODEL=gemini-2.5-flash
GEMINI_WEEKLY_REVIEW_MAX_OUTPUT_TOKENS=3000
GEMINI_WEEKLY_REVIEW_THINKING_BUDGET=0
VOICE_CAPTURE_TRANSCRIPTION_MODEL=gemini-2.5-flash
VOICE_CAPTURE_ORGANIZATION_MODEL=gemini-2.5-flash
VOICE_CAPTURE_MAX_OUTPUT_TOKENS=2500
VOICE_CAPTURE_THINKING_BUDGET=0

# Server-only cron/admin sync. Do not expose these in client code.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Organizze: server-only, GET-only migration preview. Never use NEXT_PUBLIC_.
# Use a read-only key and the Supabase user UUID that owns this Organizze account.
ORGANIZZE_EMAIL=
ORGANIZZE_API_KEY=
ORGANIZZE_USER_AGENT=
ORGANIZZE_HUB_USER_ID=

# Meu Pluggy pessoal: credenciais da aplicação demo, somente backend.
# Conecte primeiro o Nubank no Meu Pluggy e crie o proxy Meu Pluggy no Dashboard.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# UUID do usuário Hub. Se vazio, reutiliza ORGANIZZE_HUB_USER_ID.
PLUGGY_HUB_USER_ID=
# Item proxy DA APLICAÇÃO DEMO correspondente exclusivamente ao seu Nubank.
PLUGGY_NUBANK_ITEM_ID=
# Os cinco proxies devem pertencer à MESMA aplicação demo.
PLUGGY_XP_ITEM_ID=
PLUGGY_SICREDI_ITEM_ID=
PLUGGY_CAIXA_ITEM_ID=
PLUGGY_MERCADO_PAGO_ITEM_ID=
