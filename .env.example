NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# MCP is disabled unless explicitly enabled. ChatGPT receives opaque OAuth
# tokens; the encrypted Supabase session remains server-side. Direct writes
# require both flags below and the atomic RPC migration applied to the database.
MCP_ENABLED=false
MCP_OAUTH_READY=false
MCP_ENABLE_WRITES=false
MCP_DIRECT_WRITES_READY=false
MCP_PUBLIC_URL=
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_OAUTH_CLIENT_IDS=https://chatgpt.com/oauth/client.json
# Legacy proposal flow only. Direct MCP writes do not use this secret.
MCP_CONFIRMATION_SECRET=
# 32 bytes codificados em base64url (43 caracteres, sem padding).
MCP_OAUTH_ENCRYPTION_KEY=

# Server-only Google Tasks OAuth. Do not expose these in client code.
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=
GOOGLE_TASKS_TOKEN_ENCRYPTION_KEY=

# Server-only Gemini API. Do not expose this in client code.
GEMINI_API_KEY=
GEMINI_WEEKLY_REVIEW_MODEL=gemini-2.5-flash
GEMINI_WEEKLY_REVIEW_MAX_OUTPUT_TOKENS=3000
GEMINI_WEEKLY_REVIEW_THINKING_BUDGET=0
VOICE_CAPTURE_TRANSCRIPTION_MODEL=gemini-2.5-flash
VOICE_CAPTURE_ORGANIZATION_MODEL=gemini-2.5-flash
VOICE_CAPTURE_MAX_OUTPUT_TOKENS=2500
VOICE_CAPTURE_THINKING_BUDGET=0

# Server-only cron/admin sync. Do not expose these in client code.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
